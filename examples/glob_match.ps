import "ew.ps";

def match(str pattern, str text, int pattern_index, int text_index) -> bool {
    bool matched = false;

    if (pattern[pattern_index] == '\0') {
        matched = (text[text_index] == '\0');
    } else if (pattern[pattern_index] == '*') {
        if (match(pattern, text, pattern_index + 1, text_index)) {
            matched = true;
        } else if (text[text_index] != '\0') {
            matched = match(pattern, text, pattern_index, text_index + 1);
        }
    } else if (text[text_index] != '\0') {
        if ((pattern[pattern_index] == '?') | (pattern[pattern_index] == text[text_index])) {
            matched = match(pattern, text, pattern_index + 1, text_index + 1);
        }
    }

    return matched;
}

str pattern = input();
str text = input();

if (match(pattern, text, 0, 0)) {
    println(1);
} else {
    println(0);
}
