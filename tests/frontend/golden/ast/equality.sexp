(program
  (expr (call println "Enter two integers:"))
  (expr (call print "First: "))
  (var_decl int first_number (call input_int))
  (expr (call print "Second: "))
  (var_decl int second_number (call input_int))
  (var_decl bool same_numbers (== (identifier first_number) (identifier second_number)))
  (expr (call println (+ "Integers equal: " (identifier same_numbers))))
  (expr (call println "Enter two strings: "))
  (expr (call print "First: "))
  (var_decl str first_text (call input))
  (expr (call print "Second: "))
  (var_decl str second_text (call input))
  (var_decl bool same_text (== (identifier first_text) (identifier second_text)))
  (expr (call println (+ "Strings equal: " (identifier same_text))))
  (expr (call println "Enter two Arrays: "))
  (expr (call println "... well, actually it doesn't work yet"))
  (expr (call println "... well, actually I'm not sure it will"))
  (var_decl int[] first_array (array 0 1 2))
  (var_decl int[] second_array (array 0 1 2))
  (var_decl bool same_arrays (== (identifier first_array) (identifier second_array)))
  (expr (call println (+ "Arrays equal: " (identifier same_arrays)))))