// Сопоставляем файлы с расширением .ps синтаксису языка C в редакторе Zed,
// чтобы получить подсветку PuginScript через нативную в Zed подсветку C,
// причём, как оказалось, с невероятно похожим синтаксисом
{
  "file_types": {
    "C": ["ps"]
  },
  "languages": {
    "C": {
      "enable_language_server": false
    }
  }
}
